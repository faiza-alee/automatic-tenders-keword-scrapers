# ---- Database ----
POSTGRES_USER=tenders
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tenders
DATABASE_URL=postgresql+psycopg2://tenders:change-me@db:5432/tenders

# ---- API security: comma-separated, generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=replace-with-key-for-integration-developer
ADMIN_API_KEYS=replace-with-admin-key
RATE_LIMIT_PER_MINUTE=120

# ---- Monitoring ----
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=60      # 30 = every 30 min, 60 = hourly, 1440 = daily
RUN_ON_START=true
RUN_TIMEOUT_MINUTES=120

# ---- Scraper (be polite) ----
SITE_CONFIG_PATH=config/site.yaml
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
MAX_PAGES=20
USER_AGENT=GBPPRA-TenderMonitor/1.0 (+contact: you@example.com)
RESPECT_ROBOTS=true
DOWNLOAD_DOCUMENTS=true
MAX_DOCUMENT_MB=20
OCR_ENABLED=false

# ---- NLP ----
KEYWORD_METHOD=yake             # yake | tfidf | keybert
TAXONOMY_PATH=config/taxonomy.yaml
MAX_KEYWORDS=15

LOG_LEVEL=INFO
